# Sanity public configuration. These values are safe to expose in browser builds.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
PUBLIC_SANITY_STUDIO_URL=

# Draft/preview configuration. Keep real tokens out of Git and do not prefix them with PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_DRAFTS=false

# Reserved for future Sanity publish webhooks, rebuild hooks, or revalidation wiring.
SANITY_REVALIDATE_SECRET=
