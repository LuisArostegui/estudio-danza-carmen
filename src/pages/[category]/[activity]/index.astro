---
const showPreviewNotes = import.meta.env.PUBLIC_HIDE_PREVIEW_NOTES !== "true";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Carousel from "../../../components/Carousel.astro";
import EnquiryForm from "../../../components/EnquiryForm.astro";
import Photo from "../../../components/Photo.astro";
import SectionTitle from "../../../components/SectionTitle.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import {
  categoryHref,
  enquiryHref,
  familyLabel,
  familySlug,
  getActivities,
  getSchool,
  type Activity,
} from "../../../lib/catalog";

/**
 * Reusable activity template. Complete activities get the full sections;
 * pending ones get the hero, a preview note and the consultation CTA only.
 */
export async function getStaticPaths() {
  const activities = await getActivities();

  return activities.map((entry) => ({
    params: {
      category: familySlug[entry.data.family],
      activity: entry.id,
    },
    props: { entry },
  }));
}

type Props = { entry: Activity };

const { entry } = Astro.props;
const { data } = entry;
const isPending = data.status === "pending";
const rendered = isPending ? null : await render(entry);
const activities = await getActivities();
const school = await getSchool();

const familyName = familyLabel[data.family];
const categoryPath = categoryHref(data.family);
const ctaLabel = data.ctaLabel ?? "Consulta sin compromiso";
const lead = isPending ? data.summary : data.subtitle;
const faqs = data.faqs.filter((faq) => Boolean(faq.answer));
const pageTitle = data.seoTitle ?? `${data.title} · Estudio de Danza Carmen`;
---

<BaseLayout
  title={pageTitle}
  description={data.description}
  pageStatus={data.status}
>
  <article class="activity shell" data-activity-status={data.status}>
    <Breadcrumbs
      items={[
        { label: "Inicio", href: "/" },
        { label: familyName, href: categoryPath },
        { label: data.title },
      ]}
    />

    <header class="activity-hero">
      <div class="activity-hero__text">
        <SectionTitle as="h1" title={data.title} eyebrow={familyName} />
        {lead && <p class="activity-hero__lead">{lead}</p>}
        {
          !isPending && data.intro && (
            <p class="activity-hero__intro">{data.intro}</p>
          )
        }
        {
          !isPending && data.audience && (
            <p class="activity-hero__audience" data-testid="activity-audience">
              <span class="activity-hero__audience-label">¿Para quién?</span>
              {data.audience}
            </p>
          )
        }
        {
          isPending && (
            <p class="preview-note" data-testid="activity-pending-note">
              Ficha en preparación: el texto completo de esta clase se
              incorporará cuando esté disponible.
            </p>
          )
        }
        <div class="activity-hero__actions">
          <a
            class="button button--primary"
            href={enquiryHref(entry)}
            data-testid="activity-cta"
          >
            {ctaLabel}
          </a>
          <a class="text-link" href={categoryPath}>Volver a {familyName}</a>
        </div>
      </div>

      <div class="activity-hero__media">
        <Photo
          photo={data.photo}
          sizes="(min-width: 48rem) 50vw, 100vw"
          priority
          tone="light"
        />
      </div>
    </header>

    {
      !isPending && rendered && (
        <section class="activity-body" aria-label="Descripción de la clase">
          <div class="activity-prose">
            <rendered.Content />
          </div>
        </section>
      )
    }

    {
      !isPending && data.benefits.length > 0 && (
        <section
          class="activity-benefits"
          aria-labelledby="activity-benefits-title"
        >
          <h2 id="activity-benefits-title" class="eyebrow">
            Beneficios clave
          </h2>
          <ul class="activity-benefits__list">
            {data.benefits.map((benefit) => (
              <li class="benefit">
                <svg
                  class="benefit__ornament"
                  viewBox="0 0 48 48"
                  aria-hidden="true"
                  focusable="false"
                >
                  <circle cx="24" cy="24" r="20" />
                  <circle cx="24" cy="24" r="5" />
                </svg>
                <h3 class="benefit__title">{benefit.title}</h3>
                <p class="benefit__body">{benefit.body}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      !isPending && data.gallery.length > 0 && (
        <section
          class="activity-gallery"
          aria-labelledby="activity-gallery-title"
        >
          <h2 id="activity-gallery-title" class="eyebrow">
            Galería de la clase
          </h2>
          <Carousel
            slides={data.gallery}
            label={`Fotos de la clase de ${data.title}`}
          />
        </section>
      )
    }

    {
      !isPending && data.why && (
        <section class="activity-why" aria-labelledby="activity-why-title">
          <SectionTitle id="activity-why-title" title={data.why.title} />
          <div class="activity-prose">
            {data.why.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      !isPending && faqs.length > 0 && (
        <section class="activity-faqs" aria-labelledby="activity-faqs-title">
          <SectionTitle id="activity-faqs-title" title="Preguntas frecuentes" />
          <div class="activity-faqs__list">
            {faqs.map((faq) => (
              <details class="activity-faqs__item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      !isPending && (
        <section id="consulta" class="activity-form">
          <SectionTitle
            title={data.closing?.title ?? "¿Quieres más información?"}
          />
          {data.closing && (
            <p class="activity-form__body">{data.closing.body}</p>
          )}
          <EnquiryForm
            activities={activities}
            selected={entry.id}
            school={school}
            idPrefix="consulta-ficha"
          />
        </section>
      )
    }

    {
      showPreviewNotes && data.pendingFacts.length > 0 && (
        <aside
          class="preview-note activity-pending"
          data-testid="pending-facts"
          aria-labelledby="activity-pending-title"
        >
          <p id="activity-pending-title" class="activity-pending__title">
            Pendiente de confirmar con Elena (solo vista previa)
          </p>
          <ul>
            {data.pendingFacts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</BaseLayout>

<style>
  .activity {
    display: grid;
    gap: var(--layout-block-y);
    padding-block: var(--layout-block-y);
  }

  .activity-hero {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .activity-hero__text {
    display: grid;
    gap: 1rem;
    align-content: start;
    max-width: var(--layout-text-max);
  }

  .activity-hero__lead {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--font-size-lead);
    line-height: 1.5;
  }

  .activity-hero__intro {
    margin: 0;
    color: var(--color-body);
    font-size: var(--font-size-reading);
    line-height: 1.6;
  }

  .activity-hero__audience {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--color-pink);
    color: var(--color-body);
    font-size: var(--font-size-small);
    line-height: 1.6;
  }

  .activity-hero__audience-label {
    color: var(--color-ink);
    font-size: 0.7rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .activity-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  /* Phone: photo first at 4:3, capped at 280px. */
  .activity-hero__media {
    order: -1;
    aspect-ratio: 4 / 3;
    max-block-size: 280px;
    overflow: hidden;
    background: var(--color-surface-pale);
  }

  .activity-hero__media :global(.photo) {
    block-size: 100%;
  }

  @media (min-width: 48rem) {
    .activity-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
    }

    /* Desktop: text left, photo right, hero stays under 420px tall. */
    .activity-hero__media {
      order: 0;
      max-block-size: 420px;
    }
  }

  .activity-prose {
    max-width: var(--layout-text-max);
    color: var(--color-body);
    font-size: var(--font-size-reading);
    line-height: 1.7;
  }

  .activity-prose :global(p),
  .activity-prose p {
    margin: 0 0 1rem;
  }

  .activity-prose :global(h2) {
    margin: 2.25rem 0 0.9rem;
    color: var(--color-ink);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem);
    font-weight: 400;
    letter-spacing: var(--letter-spacing-display);
    line-height: 1.25;
    text-transform: uppercase;
  }

  .activity-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .activity-benefits,
  .activity-gallery,
  .activity-why,
  .activity-faqs,
  .activity-form {
    display: grid;
    gap: 1.5rem;
  }

  .activity-benefits__list {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .activity-benefits__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .benefit {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .benefit__ornament {
    width: 2.5rem;
    height: 2.5rem;
    fill: none;
    stroke: var(--color-pink-ink);
    stroke-width: 1.25;
  }

  .benefit__ornament circle:last-child {
    fill: var(--color-pink);
    stroke: none;
  }

  .benefit__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: var(--font-weight-medium);
    line-height: 1.35;
  }

  .benefit__body {
    margin: 0;
    color: var(--color-body);
    font-size: var(--font-size-small);
    line-height: 1.6;
  }

  .activity-faqs__list {
    display: grid;
    max-width: var(--layout-text-max);
    border-top: 1px solid var(--color-border-subtle);
  }

  .activity-faqs__item {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .activity-faqs__item summary {
    cursor: pointer;
    color: var(--color-ink);
    font-weight: var(--font-weight-medium);
  }

  .activity-faqs__item summary:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .activity-faqs__item p {
    margin: 0.75rem 0 0;
    color: var(--color-body);
    line-height: 1.6;
  }

  .activity-form__body {
    margin: 0;
    max-width: var(--layout-text-max);
    color: var(--color-body);
    font-size: var(--font-size-reading);
    line-height: 1.6;
  }

  .activity-form {
    scroll-margin-top: 6rem;
  }

  .activity-pending {
    display: grid;
    gap: 0.5rem;
  }

  .activity-pending__title,
  .activity-pending ul {
    margin: 0;
  }

  .activity-pending ul {
    padding-left: 1.25rem;
  }

  .activity-pending__title {
    font-weight: var(--font-weight-semibold);
  }
</style>
