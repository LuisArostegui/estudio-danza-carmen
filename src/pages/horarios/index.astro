---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import Timetable from "../../components/Timetable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("schedule", "horario");
if (!entry) throw new Error("Missing src/content/schedule/horario.md");
const schedule = entry.data;

/** Example timetables stay noindex and out of the verified-page tests. */
const pageStatus = schedule.isExample ? "pending" : "complete";
const showPreviewNotes = import.meta.env.PUBLIC_HIDE_PREVIEW_NOTES !== "true";
/**
 * Example data is only shown in the private preview. In a public build, or
 * when no session is confirmed, the page shows a clear "no timetable yet"
 * state that points to Contacto instead of an invented timetable.
 */
const showTimetable =
  schedule.sessions.length > 0 && (!schedule.isExample || showPreviewNotes);
---

<BaseLayout
  title="Horarios · Estudio de Danza Carmen"
  description={schedule.isExample
    ? "Ejemplo de horario semanal para revisar el diseño; los horarios reales están pendientes de confirmar."
    : "Días, franjas horarias y grupos de las clases de la escuela."}
  pageStatus={pageStatus}
>
  <section class="timetable-page" aria-labelledby="schedule-title">
    <div class="shell">
      <Breadcrumbs
        items={[{ label: "Inicio", href: "/" }, { label: "Horarios" }]}
      />

      <header class="timetable-page__header">
        <SectionTitle
          as="h1"
          id="schedule-title"
          title="Horarios"
          accent="calendario"
          align="center"
        />
      </header>

      {
        schedule.isExample && (
          <p
            class="preview-note timetable-page__note"
            data-testid="schedule-example-note"
          >
            Horario de ejemplo: no es el horario real. Pendiente de confirmar
            con la escuela.
          </p>
        )
      }
      {
        schedule.note && !schedule.isExample && (
          <p class="timetable-page__note">{schedule.note}</p>
        )
      }
      {
        schedule.updated && (
          <p class="timetable-page__updated">Actualizado: {schedule.updated}</p>
        )
      }

      {
        showTimetable ? (
          <Timetable schedule={schedule} />
        ) : (
          <div class="timetable-page__empty" data-testid="schedule-empty">
            <p class="timetable-page__empty-title">
              Estamos actualizando los horarios
            </p>
            <p>
              Escríbenos y te informamos de los días, horas y grupos con plazas
              disponibles.
            </p>
            <a class="button button--primary" href="/contacto/">
              Haz tu consulta
            </a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .timetable-page {
    padding-block: var(--layout-block-y);
  }

  .timetable-page__header {
    margin-bottom: 1.5rem;
  }

  .timetable-page__note,
  .timetable-page__updated {
    max-width: var(--layout-text-max);
    margin: 0 auto;
    text-align: center;
  }

  .timetable-page__empty {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    max-width: 36rem;
    margin: 2rem auto 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-tint-line);
    background: var(--color-surface-pale);
    text-align: center;
  }

  .timetable-page__empty p {
    margin: 0;
  }

  .timetable-page__empty-title {
    color: var(--color-ink);
    font-weight: var(--font-weight-medium);
  }

  .timetable-page__updated {
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
  }
</style>
