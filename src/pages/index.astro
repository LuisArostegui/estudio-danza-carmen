---
import EditorialCard from "../components/editorial/EditorialCard.astro";
import SectionHeading from "../components/editorial/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomeContent } from "../lib/sanity/content";
import { getSanityImageAttrs } from "../lib/sanity/image";

const home = await getHomeContent();
const heroImage = home.heroMedia
  ? getSanityImageAttrs(home.heroMedia, {
      width: 1600,
      widths: [720, 1080, 1440, 1920],
      sizes: "100vw",
      loading: "eager",
    })
  : undefined;
const heroStyle = heroImage
  ? `--home-hero-image: url("${heroImage.src}")`
  : undefined;
---

<BaseLayout>
  <section
    class="home-hero"
    aria-labelledby="page-title"
    style={heroStyle}
    data-cms-document="homeContent"
  >
    <div class="home-hero__veil"></div>
    <div class="home-hero__content">
      <p class="script-label" data-cms-field="homeContent.scriptLabel">
        {home.scriptLabel}
      </p>
      <h1 id="page-title" data-cms-field="homeContent.title">{home.title}</h1>
      <p class="home-hero__copy" data-cms-field="homeContent.intro">
        {home.intro}
      </p>
      <div class="home-hero__actions">
        <a
          class="button button--solid"
          href={home.primaryCta.href}
          data-cms-field="homeContent.primaryCta.label"
          >{home.primaryCta.label}</a
        >
        <a
          class="button button--line"
          href={home.secondaryCta.href}
          data-cms-field="homeContent.secondaryCta.label"
          >{home.secondaryCta.label}</a
        >
      </div>
    </div>
    <a
      class="home-hero__scroll"
      href="/#academia"
      aria-label="Bajar a la siguiente seccion"
    >
      <span aria-hidden="true"></span>
    </a>
  </section>

  <section
    class="home-intro"
    id="academia"
    aria-labelledby="academy-title"
    data-cms-document="homeContent"
  >
    <div class="home-intro__inner">
      <SectionHeading
        eyebrow={home.academyEyebrow}
        eyebrowField="homeContent.academyEyebrow"
        title={home.academyTitle}
        titleField="homeContent.academyTitle"
        titleId="academy-title"
        intro={home.academyIntro}
        introField="homeContent.academyIntro"
      />
    </div>
  </section>

  <section
    class="home-class-pathways"
    aria-labelledby="class-pathways-title"
    data-cms-document="homeContent"
  >
    <div class="home-section__inner">
      <SectionHeading
        eyebrow={home.classPathwaysEyebrow}
        eyebrowField="homeContent.classPathwaysEyebrow"
        title={home.classPathwaysTitle}
        titleField="homeContent.classPathwaysTitle"
        titleId="class-pathways-title"
        intro={home.classPathwaysIntro}
        introField="homeContent.classPathwaysIntro"
      />
      <div class="editorial-grid editorial-grid--four">
        {
          home.classPathways.map((card, index) => (
            <EditorialCard
              card={card}
              fieldBase={`homeContent.classPathways[${index}]`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-planning"
    aria-labelledby="planning-title"
    data-cms-document="homeContent"
  >
    <div class="home-section__inner home-section__inner--split">
      <SectionHeading
        eyebrow={home.planningEyebrow}
        eyebrowField="homeContent.planningEyebrow"
        title={home.planningTitle}
        titleField="homeContent.planningTitle"
        titleId="planning-title"
        intro={home.planningIntro}
        introField="homeContent.planningIntro"
      />
      <div class="editorial-stack">
        {
          home.planningCards.map((card, index) => (
            <EditorialCard
              card={card}
              fieldBase={`homeContent.planningCards[${index}]`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-trust"
    aria-labelledby="trust-title"
    data-cms-document="homeContent"
  >
    <div class="home-section__inner">
      <SectionHeading
        eyebrow={home.trustEyebrow}
        eyebrowField="homeContent.trustEyebrow"
        title={home.trustTitle}
        titleField="homeContent.trustTitle"
        titleId="trust-title"
        intro={home.trustIntro}
        introField="homeContent.trustIntro"
        align="center"
      />
      <div class="editorial-grid editorial-grid--three">
        {
          home.trustItems.map((card, index) => (
            <EditorialCard
              card={card}
              fieldBase={`homeContent.trustItems[${index}]`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-discovery"
    aria-labelledby="discovery-title"
    data-cms-document="homeContent"
  >
    <div class="home-section__inner">
      <SectionHeading
        eyebrow={home.discoveryEyebrow}
        eyebrowField="homeContent.discoveryEyebrow"
        title={home.discoveryTitle}
        titleField="homeContent.discoveryTitle"
        titleId="discovery-title"
      />
      <div class="editorial-grid editorial-grid--three editorial-grid--ruled">
        {
          home.discoveryCards.map((card, index) => (
            <EditorialCard
              card={card}
              fieldBase={`homeContent.discoveryCards[${index}]`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-final"
    aria-labelledby="final-title"
    data-cms-document="homeContent"
  >
    <div class="home-final__inner">
      <SectionHeading
        eyebrow={home.finalPrompt.eyebrow}
        eyebrowField="homeContent.finalPrompt.eyebrow"
        title={home.finalPrompt.title}
        titleField="homeContent.finalPrompt.title"
        titleId="final-title"
        intro={home.finalPrompt.intro}
        introField="homeContent.finalPrompt.intro"
        align="center"
      />
      <div class="home-final__actions">
        <a
          class="button button--solid"
          href={home.finalPrompt.primaryCta.href}
          data-cms-field="homeContent.finalPrompt.primaryCta.label"
          >{home.finalPrompt.primaryCta.label}</a
        >
        {
          home.finalPrompt.secondaryCta && (
            <a
              class="button button--line"
              href={home.finalPrompt.secondaryCta.href}
              data-cms-field="homeContent.finalPrompt.secondaryCta.label"
            >
              {home.finalPrompt.secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
