---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeStory from "../components/home/HomeStory.astro";
import HomeClasses from "../components/home/HomeClasses.astro";
import HomeReasons from "../components/home/HomeReasons.astro";
import HomeRad from "../components/home/HomeRad.astro";
import ShowGallery from "../components/home/ShowGallery.astro";
import HomeTestimonials from "../components/home/HomeTestimonials.astro";
import HomeGift from "../components/home/HomeGift.astro";
import InstagramStrip from "../components/home/InstagramStrip.astro";
import HomeContact from "../components/home/HomeContact.astro";

const home = await getEntry("home", "inicio");
if (!home) throw new Error("Missing src/content/home/inicio.md");
const d = home.data;
---

<BaseLayout title={d.title} description={d.description}>
  <HomeHero hero={d.hero} />
  <HomeStory story={d.story} />
  <HomeClasses classes={d.classes} />
  <HomeReasons reasons={d.reasons} />
  <HomeRad rad={d.rad} />
  <ShowGallery shows={d.shows} />
  <HomeTestimonials testimonials={d.testimonials} />
  <HomeGift gift={d.gift} />
  <InstagramStrip instagram={d.instagram} />
  <HomeContact contact={d.contact} />
</BaseLayout>
