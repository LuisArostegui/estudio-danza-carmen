---
import { getSchool, getSiteNavigation } from "../lib/catalog";
import type { SiteSettings } from "../lib/sanity/types";

type Props = {
  currentPath: string;
  siteSettings?: SiteSettings;
};

const { currentPath } = Astro.props;
const [menu, school] = await Promise.all([getSiteNavigation(), getSchool()]);

const normalize = (path: string) =>
  (path.split(/[?#]/)[0] || "/").replace(/\/+$/, "") || "/";
const here = normalize(currentPath);
const isExact = (href: string) => normalize(href) === here;
const isWithin = (href: string) => {
  const target = normalize(href);
  return target !== "/" && (here === target || here.startsWith(`${target}/`));
};
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a
      class="site-header__brand"
      href="/"
      aria-label={`${school.name}, inicio`}
    >
      {school.name}
    </a>

    <button
      class="site-header__menu-button"
      type="button"
      aria-controls="site-navigation"
      aria-expanded="false"
      aria-label="Abrir menú"
      data-menu-button
    >
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

    <nav
      class="site-nav"
      id="site-navigation"
      aria-label="Navegación principal"
      data-site-navigation
    >
      <ul class="site-nav__list">
        {
          menu.map((item, index) => {
            const current = isWithin(item.href);
            const children = item.children ?? [];
            const panelId = `submenu-${index}`;
            return (
              <li
                class:list={[
                  "site-nav__item",
                  { "has-menu": children.length > 0 },
                ]}
              >
                <div class="site-nav__row">
                  <a
                    class:list={["site-nav__link", { "is-current": current }]}
                    href={item.href}
                    aria-current={
                      isExact(item.href) ? "page" : current ? "true" : undefined
                    }
                    data-category-link
                  >
                    {item.label}
                    {item.status === "pending" && (
                      <span class="visually-hidden"> (en preparación)</span>
                    )}
                    {children.length > 0 && (
                      <svg
                        class="site-nav__chevron"
                        viewBox="0 0 10 6"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path
                          d="M1 1l4 4 4-4"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.2"
                        />
                      </svg>
                    )}
                  </a>
                  {children.length > 0 && (
                    <button
                      class="site-nav__toggle"
                      type="button"
                      aria-expanded="false"
                      aria-controls={panelId}
                      aria-label={`Mostrar clases de ${item.label}`}
                      data-submenu-toggle
                    >
                      <svg
                        viewBox="0 0 10 6"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path
                          d="M1 1l4 4 4-4"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.2"
                        />
                      </svg>
                    </button>
                  )}
                </div>
                {children.length > 0 && (
                  <ul class="site-nav__panel" id={panelId}>
                    {children.map((child) => (
                      <li>
                        <a
                          class="site-nav__child"
                          href={child.href}
                          aria-current={
                            isExact(child.href) ? "page" : undefined
                          }
                        >
                          {child.label}
                          {child.status === "pending" && (
                            <>
                              <span
                                class="site-nav__pending"
                                aria-hidden="true"
                              />
                              <span class="visually-hidden">
                                {" "}
                                (en preparación)
                              </span>
                            </>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const button = header?.querySelector<HTMLButtonElement>("[data-menu-button]");
  const nav = header?.querySelector<HTMLElement>("[data-site-navigation]");

  if (header && button && nav) {
    const setMenu = (open: boolean, restoreFocus = false) => {
      header.toggleAttribute("data-menu-open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      document.body.classList.toggle("menu-open", open);
      if (!open && restoreFocus) button.focus();
    };

    button.addEventListener("click", () =>
      setMenu(button.getAttribute("aria-expanded") !== "true", true),
    );

    for (const toggle of nav.querySelectorAll<HTMLButtonElement>(
      "[data-submenu-toggle]",
    )) {
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        toggle.closest(".site-nav__item")?.classList.toggle("is-open", open);
      });
    }

    const desktop = window.matchMedia("(min-width: 64rem)");
    desktop.addEventListener("change", () => setMenu(false));

    const items = nav.querySelectorAll<HTMLElement>(".has-menu");
    for (const item of items) {
      const clear = () => item.classList.remove("is-dismissed");
      item.addEventListener("pointerleave", clear);
      item.addEventListener("keydown", (event) => {
        if (["ArrowDown", "Enter", " "].includes(event.key)) clear();
      });
      item.addEventListener("focusout", (event) => {
        if (!item.contains(event.relatedTarget as Node | null)) clear();
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (!desktop.matches && button.getAttribute("aria-expanded") === "true") {
        setMenu(false, true);
        return;
      }
      if (desktop.matches) {
        // Close every open panel: the one holding focus and any hovered one.
        // Focus returns to the category that owned it; with hover only, focus
        // stays where it was so the panel does not reopen via :focus-within.
        const focused = [...items].find((item) =>
          item.matches(":focus-within"),
        );
        for (const item of items) {
          if (item === focused || item.matches(":hover"))
            item.classList.add("is-dismissed");
        }
        focused?.querySelector<HTMLElement>("[data-category-link]")?.focus();
      }
    });

    nav.addEventListener("click", (event) => {
      if (!desktop.matches && (event.target as Element).closest("a"))
        setMenu(false);
    });
  }
</script>
