---
import { isCurrentPath } from "../lib/navigation";
import type { SiteSettings } from "../lib/sanity/types";

type Props = {
  currentPath: string;
  siteSettings: SiteSettings;
};

const { currentPath, siteSettings } = Astro.props;
const addressLines = siteSettings.address
  .split(/\r?\n/)
  .map((line) => line.trim())
  .filter(Boolean);
---

<div class="site-topbar">
  <div class="site-topbar__inner">
    <p data-cms-field="siteSettings.topbarMessage">
      {siteSettings.topbarMessage}
    </p>
    <div class="site-topbar__details">
      {
        siteSettings.email && (
          <a
            href={`mailto:${siteSettings.email}`}
            data-cms-field="siteSettings.email"
          >
            {siteSettings.email}
          </a>
        )
      }
      {
        addressLines.length > 0 && (
          <span data-cms-field="siteSettings.address">
            {addressLines.join(", ")}
          </span>
        )
      }
      <span data-cms-field="siteSettings.phoneLabel">
        {siteSettings.phoneLabel}
      </span>
    </div>
  </div>
</div>

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a
      class="site-header__brand"
      href="/"
      aria-label={siteSettings.siteName}
      data-cms-field="siteSettings.brandLabel"
    >
      <span class="site-header__brand-mark">{siteSettings.brandLabel}</span>
    </a>

    <nav
      class="site-nav site-nav--desktop"
      aria-label={siteSettings.mainNavigationLabel}
    >
      <ul class="site-nav__list">
        {
          siteSettings.headerNavigation.map((item, index) => {
            const isCurrent = isCurrentPath(currentPath, item);

            return (
              <li>
                <a
                  class:list={["site-nav__link", { "is-current": isCurrent }]}
                  href={item.href}
                  aria-current={isCurrent ? "page" : undefined}
                  data-cms-field={`siteSettings.headerNavigation[${index}].label`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a
      class="site-header__search"
      href="/classes/"
      aria-label={siteSettings.searchLabel}
    >
    </a>

    <button
      class="site-header__menu-button"
      type="button"
      aria-controls="site-navigation"
      aria-expanded="false"
      data-menu-button
    >
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span data-cms-field="siteSettings.menuLabel"
        >{siteSettings.menuLabel}</span
      >
    </button>
  </div>

  <nav
    class="site-nav site-nav--mobile"
    id="site-navigation"
    aria-label={siteSettings.mobileNavigationLabel}
    data-site-navigation
  >
    <ul class="site-nav__list">
      {
        siteSettings.headerNavigation.map((item, index) => {
          const isCurrent = isCurrentPath(currentPath, item);

          return (
            <li>
              <a
                class:list={["site-nav__link", { "is-current": isCurrent }]}
                href={item.href}
                aria-current={isCurrent ? "page" : undefined}
                data-cms-field={`siteSettings.headerNavigation[${index}].label`}
                data-menu-link
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const button = header?.querySelector("[data-menu-button]");
  const navigation = header?.querySelector("[data-site-navigation]");
  const links = navigation?.querySelectorAll("[data-menu-link]") ?? [];

  if (
    button instanceof HTMLButtonElement &&
    navigation instanceof HTMLElement
  ) {
    const closeMenu = (options = { restoreFocus: false }) => {
      header?.removeAttribute("data-menu-open");
      button.setAttribute("aria-expanded", "false");
      navigation.classList.remove("is-open");
      document.body.classList.remove("menu-open");

      if (options.restoreFocus) {
        button.focus();
      }
    };

    button.addEventListener("click", () => {
      const shouldOpen = button.getAttribute("aria-expanded") !== "true";

      button.setAttribute("aria-expanded", String(shouldOpen));
      navigation.classList.toggle("is-open", shouldOpen);
      document.body.classList.toggle("menu-open", shouldOpen);

      if (shouldOpen) {
        header?.setAttribute("data-menu-open", "true");
      } else {
        header?.removeAttribute("data-menu-open");
        button.focus();
      }
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu({ restoreFocus: true });
      }
    });

    for (const link of links) {
      link.addEventListener("click", () => closeMenu());
    }
  }
</script>
