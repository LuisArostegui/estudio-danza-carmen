---
/**
 * Contact details + privacy-friendly map, shared by Home and /contacto/.
 * No third-party request on load: the OpenStreetMap embed is injected on click.
 * Needs owner confirmation: map pin position (also noted in escuela.md).
 */
import { getSchool } from "../lib/catalog";
const school = await getSchool();
const lat = school.mapLat;
const lon = school.mapLon;
const hasMap = lat !== undefined && lon !== undefined;
const d = 0.0016;
const src = !hasMap
  ? ""
  : `https://www.openstreetmap.org/export/embed.html?bbox=${lon - d * 1.6},${lat - d},${lon + d * 1.6},${lat + d}&layer=mapnik&marker=${lat},${lon}`;
const icon = {
  pin: "M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11zM12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z",
  chat: "M4 5h16v11H9l-5 4z",
  phone:
    "M6 3h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z",
  route:
    "M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM19 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM7 17h6a3 3 0 0 0 0-6h-2a3 3 0 0 1 0-6h6",
  clock: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2",
};
---

<div class="contact-block" data-reveal>
  <address class="contact-block__details">
    <p class="contact-block__name">{school.name}</p>
    <ul>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d={icon.pin}></path></svg
        >
        <span>{school.addressLine}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d={icon.chat}></path></svg
        >
        <a href={school.whatsappHref} target="_blank" rel="noopener noreferrer"
          >{school.whatsappLabel}</a
        >
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d={icon.phone}></path></svg
        >
        <a href={school.phoneHref}>{school.phoneLabel}</a>
      </li>
      {
        school.directionsHref && (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icon.route} />
            </svg>
            <a
              href={school.directionsHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              Cómo llegar
            </a>
          </li>
        )
      }
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d={icon.clock}></path></svg
        >
        <a href="/horarios/">Consulta nuestros horarios</a>
      </li>
    </ul>
  </address>

  <div class="contact-block__map" data-map data-src={src}>
    <div class="contact-block__placeholder" data-map-placeholder>
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d={icon.pin}></path></svg
      >
      <p>{school.addressLine}</p>
      {
        hasMap && (
          <>
            <button type="button" class="button button--dark" data-map-open>
              Ver mapa
            </button>
            <p class="contact-block__note">
              Al cargar el mapa se conecta con OpenStreetMap.
            </p>
          </>
        )
      }
    </div>
  </div>
</div>

<style>
  .contact-block {
    display: grid;
    gap: 2rem;
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    padding-block-start: clamp(2rem, 4vw, 3rem);
    border-block-start: 1px solid var(--color-tint-line);
  }
  @media (min-width: 48rem) {
    .contact-block {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 3rem;
      align-items: center;
    }
  }
  .contact-block__details {
    font-style: normal;
  }
  .contact-block__name {
    margin: 0 0 1rem;
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .contact-block ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact-block li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-block-size: 44px;
    border-block-end: 1px solid var(--color-tint-line);
  }
  .contact-block li:last-child {
    border-block-end: 0;
  }
  .contact-block li svg {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: none;
    stroke: var(--color-pink-ink);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contact-block a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--color-ink);
    text-underline-offset: 0.2em;
  }
  .contact-block a:focus-visible,
  .contact-block button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .contact-block__map {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-tint);
    border: 1px solid var(--color-tint-line);
  }
  .contact-block__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 1rem;
    text-align: center;
  }
  .contact-block__placeholder svg {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    fill: none;
    stroke: var(--color-pink-ink);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .contact-block__placeholder p {
    margin: 0;
    color: var(--color-body);
    font-size: var(--font-size-small);
  }
  .contact-block__placeholder .contact-block__note {
    font-size: 0.8125rem;
  }
  .contact-block__map :global(iframe) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-map]").forEach((map) => {
    const button = map.querySelector<HTMLButtonElement>("[data-map-open]");
    button?.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = map.dataset.src ?? "";
      frame.title = "Mapa: Estudio de Danza Carmen";
      frame.loading = "lazy";
      frame.referrerPolicy = "no-referrer-when-downgrade";
      frame.setAttribute("sandbox", "allow-scripts allow-same-origin");
      map.querySelector("[data-map-placeholder]")?.remove();
      map.append(frame);
      frame.focus();
    });
  });
</script>
