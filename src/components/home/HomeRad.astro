---
import Photo from "../Photo.astro";
import SectionTitle from "../SectionTitle.astro";
type Props = { rad: any };
const { rad } = Astro.props;
---

<section class="home-rad" aria-labelledby="rad-title">
  <div class="shell home-rad__inner">
    <div class="home-rad__text" data-reveal>
      <SectionTitle id="rad-title" title={rad.title} accent={rad.accent} />
      <p class="home-rad__lead">{rad.lead}</p>
      {rad.paragraphs.map((p: string) => <p>{p}</p>)}
      <a class="text-link" href={rad.cta.href}>{rad.cta.label}</a>
    </div>
    <div class="home-rad__frame" data-reveal data-reveal-delay="150">
      <div class="home-rad__photo photo-frame">
        <Photo
          photo={rad.photo}
          tone="light"
          sizes="(min-width: 64rem) 30vw, 80vw"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .home-rad {
    background: var(--color-page);
    padding-block: var(--layout-block-y);
    overflow-x: clip;
  }
  .home-rad__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  /* Phones: portrait first so it is not far down the page. */
  .home-rad__frame {
    order: -1;
  }
  .home-rad__text p {
    margin: 0 0 0.9rem;
  }
  .home-rad__text .home-rad__lead {
    color: var(--color-ink);
    font-size: var(--font-size-lead);
  }
  /* Portrait photo with a thin pink frame offset to the top-right. */
  .home-rad__frame {
    position: relative;
    inline-size: min(100%, 26rem);
    margin: 22px auto 0;
    padding-inline-end: 22px;
  }
  .home-rad__frame::before {
    content: "";
    position: absolute;
    inset: -22px 0 22px 22px;
    border: 2px solid var(--color-pink);
  }
  .home-rad__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-tint);
  }
  @media (min-width: 64rem) {
    .home-rad__frame {
      order: 0;
    }
    .home-rad__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
    .home-rad__frame {
      margin-inline: auto 0;
    }
  }
</style>
