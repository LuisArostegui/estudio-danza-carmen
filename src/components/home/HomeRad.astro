---
import Photo from "../Photo.astro";
import SectionTitle from "../SectionTitle.astro";
type Props = { rad: any };
const { rad } = Astro.props;
---

<section class="home-rad" aria-labelledby="rad-title">
  <div class="shell home-rad__inner">
    <div class="home-rad__text">
      <SectionTitle id="rad-title" title={rad.title} accent={rad.accent} />
      <p class="home-rad__lead">{rad.lead}</p>
      {rad.paragraphs.map((p: string) => <p>{p}</p>)}
      <a class="text-link" href={rad.cta.href}>{rad.cta.label}</a>
    </div>
    <div class="home-rad__frame">
      <div class="home-rad__photo">
        <Photo
          photo={rad.photo}
          tone="light"
          sizes="(min-width: 64rem) 40vw, 90vw"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .home-rad {
    background: #fff;
    padding-block: var(--layout-block-y);
  }
  .home-rad__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .home-rad__text p {
    margin: 0 0 0.9rem;
  }
  .home-rad__text .home-rad__lead {
    color: var(--color-ink);
    font-size: var(--font-size-lead);
  }
  .home-rad__frame {
    position: relative;
    margin-inline-end: 18px;
  }
  .home-rad__frame::before {
    content: "";
    position: absolute;
    inset: 18px -18px -18px 18px;
    background: var(--color-pink);
  }
  .home-rad__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  @media (min-width: 64rem) {
    .home-rad__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
    .home-rad__photo {
      aspect-ratio: 1 / 1;
    }
  }
</style>
