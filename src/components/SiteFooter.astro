---
import { getSchool } from "../lib/catalog";
import type { SiteSettings } from "../lib/sanity/types";

type Props = {
  currentPath: string;
  siteSettings?: SiteSettings;
};

const school = await getSchool();
const legal = [
  { label: "Aviso legal", href: "/legal/legal-notice/" },
  { label: "Política de privacidad", href: "/legal/privacy-policy/" },
  { label: "Política de cookies", href: "/legal/cookie-policy/" },
];
---

<footer class="site-footer">
  <div class="site-footer__inner shell">
    <div class="site-footer__business">
      <p class="site-footer__name">{school.name}</p>
      <address>{school.addressLine}</address>
    </div>

    <ul class="site-footer__links" aria-label="Contacto y horarios">
      <li>
        <a href={school.whatsappHref} target="_blank" rel="noopener noreferrer">
          {school.whatsappLabel}
        </a>
      </li>
      <li><a href={school.phoneHref}>{school.phoneLabel}</a></li>
      <li>
        <a
          href={school.directionsHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          Cómo llegar
        </a>
      </li>
      <li><a href="/horarios/">Consulta nuestros horarios</a></li>
      <li><a href="/contacto/">Contacto</a></li>
    </ul>

    <ul class="site-footer__legal" aria-label="Información legal">
      {
        legal.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
