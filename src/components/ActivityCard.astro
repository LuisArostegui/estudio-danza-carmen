---
import Photo from "./Photo.astro";
import { activityHref, type Activity } from "../lib/catalog";

type Props = { activity: Activity };

const { activity } = Astro.props;
const { data } = activity;
const isPending = data.status === "pending";
---

<a
  class="activity-card"
  href={activityHref(activity)}
  data-status={data.status}
  data-testid="activity-card"
>
  <div class="activity-card__media">
    <Photo
      decorative
      photo={data.photo}
      sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw"
      tone="light"
    />
  </div>
  <div class="activity-card__body">
    <h3 class="activity-card__title">{data.title}</h3>
    {data.summary && <p class="activity-card__summary">{data.summary}</p>}
    {
      isPending ? (
        <span class="activity-card__badge">Ficha en preparación</span>
      ) : (
        <span class="activity-card__cta">Ver clase →</span>
      )
    }
  </div>
</a>

<style>
  .activity-card {
    display: grid;
    height: 100%;
    color: var(--color-ink);
    text-decoration: none;
  }

  .activity-card:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }

  .activity-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-pale);
  }

  .activity-card__media :global(.photo) {
    transform-origin: center;
  }

  .activity-card__body {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding-block-start: 1rem;
  }

  .activity-card__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .activity-card__summary {
    margin: 0;
    color: var(--color-body);
    font-size: var(--font-size-small);
    line-height: 1.55;
  }

  .activity-card__cta {
    justify-self: start;
    margin-block-start: 0.25rem;
    color: var(--color-pink-ink);
    font-size: 0.72rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  .activity-card__badge {
    justify-self: start;
    margin-block-start: 0.25rem;
    padding: 0.3rem 0.6rem;
    background: var(--color-pink);
    color: #6e4049;
    font-size: 0.68rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .activity-card:hover .activity-card__media :global(.photo),
    .activity-card:focus-visible .activity-card__media :global(.photo) {
      transform: scale(var(--motion-image-zoom));
    }

    .activity-card__media :global(.photo) {
      transition: transform var(--motion-duration-base) var(--motion-ease-image);
    }
  }
</style>
