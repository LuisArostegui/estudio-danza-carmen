---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getSiteSettings } from "../lib/sanity/content";
import "@fontsource-variable/montserrat";
import "@fontsource/pinyon-script";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  /** Pending pages are noindex and excluded from verified-page tests. */
  pageStatus?: "complete" | "pending";
};

const siteSettings = await getSiteSettings();
const { title, description, pageStatus = "complete" } = Astro.props;
const currentPath = Astro.url.pathname;
const pageTitle = title ?? siteSettings.siteName;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {pageStatus === "pending" && <meta name="robots" content="noindex" />}
    <script is:inline>
      /* Headline comparison: ?titulo=serif switches H1 / section titles to Cormorant. */
      if (new URLSearchParams(location.search).get("titulo") === "serif") {
        document.documentElement.dataset.titulo = "serif";
      }
    </script>
    <style is:global>
      [data-titulo="serif"] .section-title {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: calc(var(--font-size-title) * 1.18);
        font-weight: 500;
        letter-spacing: 0.01em;
        line-height: 1.1;
        text-transform: none;
      }
    </style>
  </head>
  <body data-page-status={pageStatus}>
    <SiteHeader currentPath={currentPath} siteSettings={siteSettings} />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <SiteFooter currentPath={currentPath} siteSettings={siteSettings} />
    <script is:inline>
      (() => {
        const params = new URLSearchParams(window.location.search);

        if (params.get("cms") !== "keys") {
          return;
        }

        document.documentElement.dataset.cmsDebug = "keys";

        document.querySelectorAll("[data-cms-field]").forEach((element) => {
          const field = element.getAttribute("data-cms-field");

          if (!field) {
            return;
          }

          element.setAttribute("data-cms-original", element.textContent ?? "");
          element.setAttribute("title", `Sanity field: ${field}`);
          element.textContent = field;
        });
      })();
    </script>
  </body>
</html>
