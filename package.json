{
  "name": "estudio-danza-carmen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:review": "PUBLIC_HIDE_PREVIEW_NOTES=true PUBLIC_REVIEW_NOINDEX=true PUBLIC_REVIEW_HIDE_PHOTOS=true astro build --outDir dist-review && node scripts/prune-review-photos.mjs dist-review && node scripts/write-review-headers.mjs dist-review && node scripts/verify-review-build.mjs dist-review",
    "deploy:review": "node scripts/verify-review-build.mjs dist-review && pnpm dlx wrangler@4.164.0 deploy --env review",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "check:shell": "node scripts/verify-site-shell.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "format": "prettier --write .prettierrc README.md \"*.{mjs,json,yaml}\" \"scripts/**/*.mjs\" \"src/**/*.{astro,css,js,json,ts}\" \"tests/**/*.{ts,mjs}\"",
    "format:check": "prettier --check .prettierrc README.md \"*.{mjs,json,yaml}\" \"scripts/**/*.mjs\" \"src/**/*.{astro,css,js,json,ts}\" \"tests/**/*.{ts,mjs}\"",
    "validate": "pnpm check:tooling && pnpm typecheck && pnpm format:check && pnpm test:unit && pnpm check:studio && pnpm check:content && pnpm check:media && pnpm build && pnpm check:shell && pnpm check:home && pnpm check:public && pnpm check:courses && pnpm test:site && pnpm test:e2e",
    "check:content": "node scripts/verify-content-pipeline.mjs",
    "check:media": "node scripts/verify-media-pipeline.mjs",
    "studio:dev": "pnpm --filter estudio-danza-carmen-studio dev",
    "studio:build": "pnpm --filter estudio-danza-carmen-studio build",
    "check:studio": "pnpm studio:build",
    "check:home": "node scripts/verify-home-page.mjs",
    "check:tooling": "node scripts/verify-project-tooling.mjs",
    "test:site": "node scripts/verify-generated-site-links.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:engines": "pnpm build && PLAYWRIGHT_ENGINES=firefox,webkit playwright test",
    "check:public": "node scripts/verify-public-build.mjs",
    "check:courses": "node scripts/verify-courses-page.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@sanity/client": "^8.17.0",
    "@sanity/image-url": "^2.2.0",
    "astro": "^7.4.13",
    "sharp": "0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "linkinator": "8.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.23.4 <24"
  }
}
