{
  "name": "estudio-danza-carmen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "check:shell": "node scripts/verify-site-shell.mjs",
    "format": "prettier --write .prettierrc README.md \"*.{mjs,json,yaml}\" \"scripts/**/*.mjs\" \"src/**/*.{astro,css,js,json,ts}\" \"tests/**/*.{mjs,ts}\"",
    "format:check": "prettier --check .prettierrc README.md \"*.{mjs,json,yaml}\" \"scripts/**/*.mjs\" \"src/**/*.{astro,css,js,json,ts}\" \"tests/**/*.{mjs,ts}\"",
    "validate": "pnpm check:tooling && pnpm typecheck && pnpm format:check && pnpm test:unit && pnpm check:studio && pnpm check:content && pnpm check:media && pnpm build && pnpm check:shell && pnpm check:home && pnpm test:site && pnpm test:e2e:built",
    "check:content": "node scripts/verify-content-pipeline.mjs",
    "check:media": "node scripts/verify-media-pipeline.mjs",
    "studio:dev": "pnpm --filter estudio-danza-carmen-studio dev",
    "studio:build": "pnpm --filter estudio-danza-carmen-studio build",
    "check:studio": "pnpm --filter estudio-danza-carmen-studio typecheck && pnpm --filter estudio-danza-carmen-studio lint && pnpm studio:build",
    "check:home": "node scripts/verify-home-page.mjs",
    "check:tooling": "node scripts/verify-project-tooling.mjs",
    "test:unit": "node --loader ./tests/ts-loader.mjs --test tests/unit/**/*.test.mjs",
    "test:site": "node scripts/verify-generated-site-links.mjs",
    "test:e2e": "pnpm build && pnpm test:e2e:built",
    "test:e2e:built": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@sanity/client": "^8.2.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.2.6",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "linkinator": "8.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1"
  },
  "engines": {
    "node": ">=22.12 <24"
  }
}
