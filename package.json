{
  "name": "estudio-danza-carmen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "check:shell": "node scripts/verify-site-shell.mjs",
    "format": "prettier --write .prettierrc README.md \"*.{mjs,json,yaml}\" \"scripts/**/*.mjs\" \"src/**/*.{astro,css,js,json,ts}\"",
    "format:check": "prettier --check .prettierrc README.md \"*.{mjs,json,yaml}\" \"scripts/**/*.mjs\" \"src/**/*.{astro,css,js,json,ts}\"",
    "validate": "pnpm typecheck && pnpm format:check && pnpm build && pnpm check:shell"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.6",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1"
  }
}
