{
  "name": "estudio-danza-carmen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "format": "prettier --write .prettierrc \"*.{mjs,json,yaml}\" \"src/**/*.{astro,css,js,json,ts}\"",
    "format:check": "prettier --check .prettierrc \"*.{mjs,json,yaml}\" \"src/**/*.{astro,css,js,json,ts}\"",
    "validate": "pnpm typecheck && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.13.3",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1"
  }
}
